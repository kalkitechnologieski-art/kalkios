'use client'

import { useState, useRef } from 'react'
import { ImageIcon, Video, Search, Users, Brain, X, Loader2, Paperclip } from 'lucide-react'
import { LuxuryButton } from '@/components/ui/LuxuryButton'
import { motion, AnimatePresence } from 'framer-motion'
import { CosmicPromptBar } from '@/components/ui/CosmicPromptBar'

interface NeonComposerProps {
  onSend: (text: string, file?: File) => void
  isLoading: boolean
  mode: 'chat' | 'image' | 'video'
  onModeChange: (mode: 'chat' | 'image' | 'video') => void
  isDeepThink: boolean
  setIsDeepThink: (val: boolean) => void
  isSetuMode: boolean
  setIsSetuMode: (val: boolean) => void
  isSearchMode: boolean
  setIsSearchMode: (val: boolean) => void
  onClear?: () => void
  className?: string
}

export function NeonComposer({
  onSend,
  isLoading,
  mode,
  onModeChange,
  isDeepThink,
  setIsDeepThink,
  isSetuMode,
  setIsSetuMode,
  isSearchMode,
  setIsSearchMode,
  onClear,
  className = '',
}: NeonComposerProps) {
  const [text, setText] = useState('')
  const [file, setFile] = useState<File | null>(null)
  const [previewUrl, setPreviewUrl] = useState<string | null>(null)
  const fileInputRef = useRef<HTMLInputElement>(null)

  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const f = e.target.files?.[0]
    if (!f) return
    setFile(f)
    setPreviewUrl(URL.createObjectURL(f))
    e.target.value = ''
  }

  const clearFile = () => {
    setFile(null)
    setPreviewUrl(null)
  }

  const handleSend = (textToSend: string) => {
    if ((!textToSend.trim() && !file) || isLoading) return
    onSend(textToSend, file || undefined)
    setText('')
    setFile(null)
    setPreviewUrl(null)
  }

  const getModeColor = () => {
    switch (mode) {
      case 'image': return 'border-pink-500/30 shadow-pink-500/10'
      case 'video': return 'border-red-500/30 shadow-red-500/10'
      default: return 'border-cyan-500/20 shadow-cyan-500/5'
    }
  }

  return (
    <div className={`flex flex-col gap-2 ${className}`}>
      {/* Mode indicators */}
      <div className="flex items-center gap-2 flex-wrap text-[10px] text-white/30 font-mono">
        <span className={`px-2 py-0.5 rounded-full border transition-all duration-200 ${mode === 'chat' ? 'bg-cyan-600/20 text-cyan-400 border-cyan-500/30 shadow-glow' : 'border-white/10'}`}>
          💬 Chat
        </span>
        {isDeepThink && <span className="px-2 py-0.5 bg-purple-600/20 text-purple-400 border border-purple-500/30 rounded-full shadow-glow animate-pulse">🧠 Deep</span>}
        {isSearchMode && <span className="px-2 py-0.5 bg-blue-600/20 text-blue-400 border border-blue-500/30 rounded-full shadow-glow">🔎 Search</span>}
        {isSetuMode && <span className="px-2 py-0.5 bg-amber-600/20 text-amber-400 border border-amber-500/30 rounded-full shadow-glow">👥 SETU</span>}
        {mode === 'image' && <span className="px-2 py-0.5 bg-pink-600/20 text-pink-400 border border-pink-500/30 rounded-full shadow-glow">🖼️ Image</span>}
        {mode === 'video' && <span className="px-2 py-0.5 bg-red-600/20 text-red-400 border border-red-500/30 rounded-full shadow-glow">🎬 Video</span>}
        {onClear && (
          <button onClick={onClear} className="text-red-400/60 hover:text-red-400 transition text-xs">✕ Clear</button>
        )}
      </div>

      {/* File preview */}
      <AnimatePresence>
        {file && previewUrl && (
          <motion.div
            initial={{ opacity: 0, scale: 0.95, y: 10 }}
            animate={{ opacity: 1, scale: 1, y: 0 }}
            exit={{ opacity: 0, scale: 0.95, y: -10 }}
            className="bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-3 flex items-center gap-3"
          >
            {file.type.startsWith('image/') && (
              <img src={previewUrl} alt="Preview" className="w-12 h-12 object-cover rounded-lg" />
            )}
            {file.type.startsWith('video/') && (
              <video src={previewUrl} className="w-12 h-12 object-cover rounded-lg" muted />
            )}
            <div className="flex-1 min-w-0">
              <p className="text-sm text-white truncate">{file.name}</p>
              <p className="text-xs text-white/30">{(file.size / 1024).toFixed(0)} KB</p>
            </div>
            <button onClick={clearFile} className="p-1.5 rounded-full hover:bg-white/10 text-white/40 hover:text-white transition">
              <X className="w-4 h-4" />
            </button>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Cosmic Prompt Bar with mode */}
      <CosmicPromptBar
        onSend={handleSend}
        isLoading={isLoading}
        placeholder={mode === 'image' ? 'Describe the image...' : mode === 'video' ? 'Describe the video...' : 'Ask Siddhi anything...'}
        mode={mode}
      />
    </div>
  )
}
