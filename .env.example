# ═══ SIDDHI OMNIBUS v4.0 — ENVIRONMENT TEMPLATE ═══

# ─── Core ───
NEXT_PUBLIC_APP_URL=https://kalkios.com
NEXT_PUBLIC_SITE_URL=https://kalkios.com

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OAuth ───
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret

# ─── AI Providers ───
OPENROUTER_API_KEY=your-openrouter-key
GROQ_API_KEY=your-groq-key
ZHIPU_API_KEY=your-zhipu-key
AGNES_API_KEY=your-agnes-key

# ─── Payments ───
INSTAMOJO_API_KEY=your-instamojo-key
INSTAMOJO_AUTH_TOKEN=your-instamojo-token
INSTAMOJO_PRIVATE_SALT=your-instamojo-salt

# ─── Infrastructure (optional) ───
REDIS_URL=redis://localhost:6379
SEARXNG_URL=http://localhost:8080
BRAVE_API_KEY=your-brave-key

# ─── SIDDHI v4.0 FEATURE FLAGS ───
SIDDHI_PIPELINE_V4=true
SIDDHI_TOKEN_STREAMING=true
SIDDHI_7PATH_REASONING=true
SIDDHI_SELF_CRITIQUE=true
SIDDHI_TOOLS=true
SIDDHI_VISION=true
SIDDHI_ARTIFACTS=true
SIDDHI_PERSISTENT_MEMORY=true
SIDDHI_VOICE=true
SIDDHI_TELEMETRY=true
SIDDHI_DEVICE_ENGINE=true
SIDDHI_OMNIBUS_ROUTER=true
